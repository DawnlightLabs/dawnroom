---
import Base from '../../layouts/Base.astro';
import Print from '../../components/Print.astro';
import Command from '../../components/Command.astro';
import Note from '../../components/Note.astro';
import HardwareCheck from '../../components/HardwareCheck.astro';
import FitBadges from '../../components/FitBadges.astro';
import Reproduce from '../../components/Reproduce.astro';
import Icon from '../../components/Icon.astro';
import { loadModels, loadFamilies, fitModel, gb, gib, mainTask, TAG_LABELS, TASK_LABELS, type Model } from '../../lib/registry';
import { estimateMib } from '../../lib/fit';
import { fitFor, type Verdict } from '../../lib/fit';
import { stockOf } from '../../lib/stocks';
import { BIN } from '../../config';
import cardData from '../../modelCards.json';

export function getStaticPaths() {
  return loadModels().map((m, i) => ({ params: { id: m.id }, props: { m, no: i + 1 } }));
}
const { m, no } = Astro.props as { m: Model; no: number };
const st = stockOf(m.id);
// The maker's own material, researched from the official card: showcase images (credited) and best uses.
type CardInfo = { card: string | null; uses: string[]; avoid: string[]; sources: string[]; images: { file: string; width: number; height: number; caption: string; source: string }[] };
const card = (cardData as Record<string, CardInfo>)[m.id];
const maker = m.original?.split('/')[0] ?? 'the maker';
const uses = st.uses.length ? st.uses : (card?.uses ?? []);
const avoid = st.uses.length ? st.avoid : (card?.avoid ?? []);
const d = m.defaults;
// The main task's measurements set the headline numbers and the fit (engine/src/fit.rs main_task);
// an edit measurement of a model that also generates is shown on its own line.
const families = loadFamilies();
const fm = fitModel(m, families.flatMap((f) => f.devices));
const roles: Record<string, string> = {
  diffusion_model: 'Diffusion model', uncond_diffusion_model: 'Unconditional model', checkpoint: 'Checkpoint', llm: 'Text encoder', llm_vision: 'Vision encoder',
  clip_l: 'CLIP-L', clip_g: 'CLIP-G', t5xxl: 'T5-XXL', vae: 'VAE', tokenizer: 'Tokenizer',
};
const pullId = m.variants.length > 1 ? `${m.id}:${m.tag}` : m.id;
const need = (v: Model['variants'][number]) => {
  const own = v.measured.filter((x) => !x.integrated && (x.task ?? 'generate') === mainTask(v.tasks));
  return own.length ? { mib: Math.max(...own.map((x) => x.need_mib ?? x.peak_vram_mib)), est: false } : { mib: estimateMib(v.bytes), est: true };
};
const supportLabel: Record<string, string> = { now: 'Works now', experimental: 'Experimental', planned: 'Planned', 'not planned': 'Not planned' };
const short: Record<Verdict, string> = { works: 'fits', offload: 'with RAM offload', experimental: 'fits', later: 'fits', needs: 'too small', unsupported: '—', unknown: '?' };

// "Runs on": every device in the hardware table, every memory size it ships in.
const runsOn = families.map((f) => {
  const rows = f.devices.map((dev) => ({
    dev,
    sizes: dev.memory_gb.map((g) => ({ g, fit: fitFor(fm, dev, g) })),
  }));
  const sizes = rows.flatMap((r) => r.sizes);
  const fitting = sizes.filter((s) => ['works', 'experimental', 'later'].includes(s.fit.verdict)).length;
  return { f, rows, summary: f.supported === 'not planned' ? f.notes : sizes.length ? `${fitting} of ${sizes.length} memory sizes fit` : '' };
});
const canEdit = (m.tasks ?? ['generate']).includes('edit');
const canGenerate = (m.tasks ?? ['generate']).includes('generate');
---
<Base title={m.name} nav="models" description={`${m.name}: ${m.tagline} Does it run on your GPU? Size, memory and licence.`}>
  <article class="wrap pt-6 pb-16 md:pt-8">
    <nav aria-label="Breadcrumb" class="edge text-muted"><a href="/search" class="inline-flex items-center gap-1"><Icon name="back" class="i-sm" />Models</a> <span aria-hidden="true">/</span> <span aria-current="page">{m.id}</span></nav>

    <!-- Masthead: like the top of a film data sheet -->
    <header class="sheet-rule mt-4 pt-3">
      <div class="eyebrow flex flex-wrap justify-between gap-x-6 gap-y-1 text-muted">
        <span>Technical data · stock no. {String(no).padStart(3, '0')}</span>
        <span>{m.licenceLabel}{m.licence.accept_required && ' · licence acceptance needed'}{m.preset && ` · ${m.preset} preset`}</span>
      </div>
      <div class="mt-4 grid gap-6 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <span class="inline-block h-1.5 w-10 rounded-full" style={`background:${st.colour}`} aria-hidden="true"></span>
          <h1 class="display mt-2.5 text-[2.4rem] leading-[1] sm:text-[3rem]">{m.name}</h1>
          <p class="mt-2.5 max-w-xl text-[15.5px] text-ink/85">{m.tagline}</p>
          <p class="mt-3 flex flex-wrap gap-1.5">
            {(m.tags ?? []).map((t) => <a href={`/search?tag=${t}`} class="code-link">{TAG_LABELS[t] ?? t}</a>)}
          </p>
        </div>
        <div class="lg:col-span-5">
          <Command cmd={`${BIN} pull ${m.id}`} label={`Copy: ${BIN} pull ${m.id}`} />
          <p class="edge mt-2 text-muted">{m.variants.length > 1 ? `the tag that suits your machine ▸ ${m.variants.map((v) => v.tag).join(' · ')}` : `${gb(m.bytes)} download`} ▸ sha256 checked</p>
        </div>
      </div>
    </header>

    <!-- Characteristics -->
    <section aria-labelledby="char-h" class="mt-10">
      <h2 id="char-h" class="label">Characteristics</h2>
      <div class="annotated mt-4">
        <dl class="grid grid-cols-2 border-l border-t border-line sm:grid-cols-4">
          <div class="border-b border-r border-line px-4 py-3"><dt class="eyebrow text-muted">Does</dt><dd class="mt-1 text-[18px] leading-tight">{(m.tasks ?? ['generate']).map((t) => TASK_LABELS[t]).join(' + ')}</dd></div>
          <div class="border-b border-r border-line px-4 py-3"><dt class="eyebrow text-muted">Download</dt><dd class="mt-1 font-mono text-[24px] leading-none tabular-nums">{(m.bytes / 1e9).toFixed(1)}<small class="text-[12px]"> GB</small></dd></div>
          <div class="border-b border-r border-line px-4 py-3"><dt class="eyebrow text-muted">Memory</dt><dd class="mt-1 font-mono text-[24px] leading-none tabular-nums">{need(m.variants.find((v) => v.tag === m.tag) ?? m.variants[0]).est && <small class="text-[12px] text-muted">est. </small>}{(need(m.variants.find((v) => v.tag === m.tag) ?? m.variants[0]).mib / 1024).toFixed(1)}<small class="text-[12px]"> GB</small></dd></div>
          <div class="border-b border-r border-line px-4 py-3"><dt class="eyebrow text-muted">On your card</dt><dd class="mt-1 font-mono text-[24px] leading-none tabular-nums" data-fit-secs={pullId}></dd></div>
          {m.variants.length > 1 && <div class="col-span-2 border-b border-r border-line px-4 py-2.5 sm:col-span-4"><dd class="text-[13px] text-muted">Figures for <strong class="font-medium text-ink">{m.tag}</strong>{m.preset ? `, the ${m.preset} preset's tag` : ''}.</dd></div>}
        </dl>
        <Note of="vram" />
      </div>
    </section>

    <!-- Size tags -->
    <section aria-labelledby="tags-h" class="mt-10">
      <h2 id="tags-h" class="label">Size tags</h2>
      <div class="annotated mt-4">
        <div class="overflow-x-auto">
          <table class="w-full border-y border-line text-left text-[14px]">
            <thead class="eyebrow text-muted"><tr><th class="py-2 pr-4 font-normal">Tag</th><th class="py-2 pr-4 font-normal">Download</th><th class="py-2 pr-4 font-normal">Memory need</th><th class="py-2 font-normal">On your card</th></tr></thead>
            <tbody class="divide-y divide-line">
              {m.variants.map((v) => {
                const n = need(v);
                return (
                  <tr>
                    <td class="py-2 pr-4 font-mono">{v.tag || '—'}</td>
                    <td class="py-2 pr-4 font-mono tabular-nums">{gb(v.bytes)}</td>
                    <td class="py-2 pr-4">{n.est && <span class="text-muted">est. </span>}<span class="font-mono tabular-nums">{gib(n.mib)}</span></td>
                    <td class="py-2 edge" data-fit-model={v.id}><span class="text-muted">Pick your card below</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
          <p class="mt-3 text-[14px] text-muted">{BIN} pull {m.id} picks the largest tag that fits your machine (or one you already have); {BIN} pull {m.id}:&lt;tag&gt; picks one.</p>
        </div>
      </div>
    </section>

    <!-- On your machine -->
    <section aria-labelledby="hw-h-wrap" class="mt-10">
      <h2 id="hw-h-wrap" class="label">On your machine</h2>
      <div class="annotated mt-4">
        <HardwareCheck models={[m.id]} class="max-w-xl min-h-[220px]" />
        <Note of="unified" />
      </div>
    </section>

    <!-- Our own prints, untouched, when we have them -->
    {m.samples.length > 0 && (
      <section aria-labelledby="prints-h" class="mt-10">
        <h2 id="prints-h" class="label">Our prints · untouched</h2>
        <div class="mt-5 grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-3">
          {m.samples.map((s, i) => (
            <div>
              <Print sample={s} eager={i === 0} />
              <Reproduce sample={s} class="mt-4" />
            </div>
          ))}
        </div>
        <div class="annotated mt-6"><span></span><Note of="seed" /></div>
      </section>
    )}

    <!-- The maker's showcase, credited and linked -->
    {card?.images.length > 0 && (
      <section aria-labelledby="card-h" class="mt-10">
        <h2 id="card-h" class="label">From {maker}'s model card</h2>
        <div class="card-shots mt-5">
          {card.images.map((img, i) => (
            <figure class="m-0">
              <a href={img.source} class="card-shot" rel="noopener">
                <img src={img.file} width={img.width} height={img.height} alt={img.caption} loading={i === 0 && !m.samples.length ? 'eager' : 'lazy'} decoding="async" />
              </a>
              <figcaption class="mt-2 text-[13px] text-muted">{img.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="mt-3 text-[13px] text-muted">Published by {maker}, not made by us; the settings behind them may differ from {BIN}'s. <a href={card.card ?? m.licence.url} class="go">The model card<Icon name="external" data-diag /></a></p>
      </section>
    )}

    <!-- Uses + licence -->
    <div class="mt-10 grid gap-12 md:grid-cols-2">
      <section aria-labelledby="uses-h">
        <h2 id="uses-h" class="label">Best uses</h2>
        <ul class="mt-3 space-y-1.5 text-[14.5px]">
          {uses.map((u) => <li class="flex gap-3"><span aria-hidden="true" class="mt-[9px] size-1.5 shrink-0 rounded-full" style={`background:${st.colour}`}></span>{u}</li>)}
        </ul>
        {avoid.length > 0 && <>
          <p class="eyebrow mt-5 text-muted">Not for</p>
          <ul class="mt-2 space-y-1.5 text-[14px] text-muted">{avoid.map((a) => <li>{a}</li>)}</ul>
        </>}
        {!st.uses.length && card?.sources.length > 0 && <p class="mt-3 text-[13px] text-muted">From the model card, in our words.</p>}
      </section>

      <section aria-labelledby="licence-h">
        <h2 id="licence-h" class="label">Licence</h2>
        <p class="mt-3 font-mono text-[14px]">{m.licenceLabel}</p>
        <ul class="mt-2 space-y-1 text-[14px]">
          <li>{m.licence.commercial ? 'Commercial use allowed.' : m.licence.use_restrictions ? 'Commercial use only within the licence’s limits (see below).' : 'Non-commercial use only.'}</li>
          {m.licence.accept_required && <li>Its official repo{m.original && ` (${m.original})`} is gated. {BIN} downloads it from a mirror and asks you to accept this licence first, in Studio or the CLI.</li>}
          {m.licence.use_restrictions
            ? <li class="text-warn">{m.licence.note ?? 'Use-based restrictions apply to how you use it and its outputs.'}</li>
            : m.licence.note ? <li>{m.licence.note}</li> : <li>No use-based restrictions beyond the licence terms.</li>}
        </ul>
        <p class="mt-3 text-[14px]"><a href={m.licence.url} class="go">Read the model card and licence<Icon name="external" data-diag /></a></p>
        <p class="mt-2 text-[14px] text-muted">Check the licence yourself before shipping work made with it; this summary isn't legal advice.</p>
      </section>
    </div>

    <!-- Runs on -->
    <section aria-labelledby="runs-h" class="mt-10">
      <h2 id="runs-h" class="label">Runs on · from the hardware table</h2>
      <div class="annotated mt-4">
        <div>
          <p class="max-w-2xl text-[14px] text-muted">
            Fit compares the memory it needs ({fm.peak_mib != null ? gib(fm.peak_mib) : 'not known yet'}) plus 0.5 GB for Windows and the driver against each device’s memory
            (for unified memory, the part the GPU may use).
          </p>
          <div class="mt-4 border-t border-ink">
            {runsOn.map(({ f, rows, summary }) => (
              <details class="fam">
                <summary>
                  <span><span class="font-medium">{f.name}</span> <span class="text-[14px] text-muted">· {summary}</span></span>
                  <span class:list={['edge rounded-[3px] px-2 py-px whitespace-nowrap', f.supported === 'now' ? 'bg-safelight text-ink' : f.supported === 'experimental' ? 'border border-[#c47855]' : 'border border-line-strong text-muted']}>{supportLabel[f.supported]}</span>
                  <Icon name="down" />
                </summary>
                <div class="overflow-x-auto pb-3">
                  {f.notes && <p class="mt-3 text-[14px] text-muted">{f.notes}</p>}
                  <table class="sheet-table mt-2">
                    <caption class="sr-only">{f.name}: fit for {m.name}</caption>
                    <thead><tr><th scope="col">Device</th><th scope="col">Memory and fit</th></tr></thead>
                    <tbody>
                      {rows.map(({ dev, sizes }) => (
                        <tr>
                          <th scope="row" class="font-normal">{dev.name}</th>
                          <td class="num">
                            {sizes.length ? sizes.map((s, i) => <>{i > 0 && <span class="text-muted"> · </span>}<span class:list={[s.fit.verdict === 'needs' && 'text-warn']}>{s.g} GB{dev.unified && ` (≈${Math.floor(s.g * dev.share)} usable)`} {short[s.fit.verdict]}</span>{s.fit.secs != null && <span class="text-muted"> · about {s.fit.secs} s</span>}</>) : <span class="text-muted">—</span>}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </details>
            ))}
          </div>
        </div>
        <Note of="gguf" />
      </div>
    </section>

    <!-- Files -->
    <section aria-labelledby="files-h" class="mt-10">
      <h2 id="files-h" class="label">Files · pinned and verified</h2>
      <div class="annotated mt-4">
        <div>
          <ul class="divide-y divide-line border-y border-line">
            {m.files.map((f) => (
              <li class="grid gap-1 py-3 sm:grid-cols-[10rem_1fr_auto] sm:gap-4">
                <span class="text-[14px]">{roles[f.role] ?? f.role}</span>
                <a href={`https://huggingface.co/${f.repo}/blob/${f.revision}/${f.path}`} class="edge break-all text-muted underline-offset-2 hover:underline">{f.repo}/{f.path}</a>
                <span class="edge text-muted">{gb(f.size)}</span>
              </li>
            ))}
          </ul>
          <p class="mt-3 text-[14px] text-muted">Pinned to a commit on Hugging Face and checked by sha256 before use.</p>
        </div>
      </div>
    </section>

    <section aria-labelledby="use-h" class="mt-10">
      <h2 id="use-h" class="label">Use it</h2>
      <div class="mt-5 grid gap-3 md:max-w-2xl">
        <Command cmd={`${BIN} pull ${m.id}`} />
        {m.variants.length > 1 && <Command cmd={`${BIN} pull ${pullId}`} />}
        {canGenerate && <Command cmd={`${BIN} run --model ${pullId} "a lighthouse at first light"`} />}
        {canEdit && <Command cmd={`${BIN} run --model ${pullId} "make it night" --image photo.png`} />}
      </div>
      <p class="mt-3 text-[14px] text-muted">{`Auto picks it by itself when it's the best fit for the job on your machine; name it to use it anyway.`} In Studio, choose it in the composer's model switcher{canEdit ? ', on the Generate or Edit tab' : ''}.</p>
    </section>
  </article>
  <FitBadges />
</Base>
