---
/** Three steps, Studio and the CLI side by side. Used on the landing and /docs Install. */
import Command from './Command.astro';
import Icon from './Icon.astro';
import { getStarted, type Step } from '../lib/getStarted';

interface Props { class?: string }
const { class: cls = '' } = Astro.props;
const { studio, cli } = getStarted();
const tracks: { id: string; name: string; steps: Step[] }[] = [
  { id: 'studio', name: 'Studio', steps: studio },
  { id: 'cli', name: 'CLI', steps: cli },
];
---
<div class:list={['gs', cls]}>
  {tracks.map((t) => (
    <section class="gs-track" aria-labelledby={`gs-${t.id}`}>
      <h3 id={`gs-${t.id}`} class="gs-name">{t.name}</h3>
      <ol class="gs-steps" role="list">
        {t.steps.map((s, i) => (
          <li class="gs-step">
            <span class="gs-no" aria-hidden="true">{i + 1}</span>
            <div class="min-w-0">
              <p class="gs-title">{s.title}</p>
              <p class="gs-text">{s.text}</p>
              {s.cmd && <Command cmd={s.cmd} class="mt-2.5" />}
              {s.link && <a href={s.link.href} class="go mt-1.5 text-[14.5px]">{s.link.label}<Icon name="arrow" /></a>}
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</div>
