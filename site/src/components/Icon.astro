---
/** One icon from the sprite. Decorative unless given a label. */
import type { IconName } from '../lib/icons';
interface Props { name: IconName; class?: string; label?: string; [attr: `data-${string}`]: unknown }
const { name, class: cls = '', label, ...rest } = Astro.props;
---
<svg class:list={['i', cls]} aria-hidden={label ? undefined : 'true'} role={label ? 'img' : undefined} aria-label={label} focusable="false" {...rest}><use href={`#i-${name}`} /></svg>
