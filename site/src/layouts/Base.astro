---
import '@fontsource-variable/geist/wght.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';
import '../styles/archive.css';
import '../styles/controls.css';
import '../styles/sections.css';
import Mark from '../components/Mark.astro';
import Icons from '../components/Icons.astro';
import Icon from '../components/Icon.astro';
// Preloaded so headlines don't re-wrap when their font arrives (layout shift).
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import dmMono from '@fontsource/dm-mono/files/dm-mono-latin-400-normal.woff2?url';
import { PRODUCT_NAME, ORG, LICENCE, REPO_URL, VERSION } from '../config';
import { DAWNLIGHT_URL, ORB } from '../lib/brand';

interface Props { title?: string; description?: string; nav?: 'models' | 'docs' | 'home' | 'download' | 'vision' }
const { title, description = `${PRODUCT_NAME}: an open-source image studio that runs on your own GPU. No credits, no cloud.`, nav } = Astro.props;
const fullTitle = title ? `${title} · ${PRODUCT_NAME}` : `${PRODUCT_NAME} · Images on your own GPU`;
const links = [
  { href: '/search', label: 'Models', key: 'models' },
  { href: '/docs', label: 'Docs', key: 'docs' },
  { href: '/download', label: 'Download', key: 'download' },
  { href: '/vision', label: 'Vision', key: 'vision', wide: true }, // phones: in the footer and the landing (the header has no room)
];
// Dev only: ?motion=reduce shows the still versions without changing the OS setting.
const devMotion = import.meta.env.DEV;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcf8f5" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 24x24 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {[geist, dmMono].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ devMotion }}>
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (devMotion && new URLSearchParams(location.search).get('motion') === 'reduce') reduce = true;
      document.documentElement.dataset.motion = reduce ? 'reduce' : 'full';
      // The brand intro: once per visitor, on the header lockup in place (never an overlay).
      if (!reduce) {
        try {
          if (!localStorage.getItem('dawnroom.intro')) {
            document.documentElement.dataset.intro = '';
            localStorage.setItem('dawnroom.intro', '1');
          }
        } catch (e) {}
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Icons />
    <a class="skip" href="#main">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line bg-paper/92 backdrop-blur-sm">
      <div class="bleed flex h-13 items-center gap-2 sm:gap-4">
        <a href="/" class="flex items-center no-underline text-ink" aria-label={`${PRODUCT_NAME} home`}>
          <Mark cap={13} intro />
        </a>
        <a href={DAWNLIGHT_URL} class="hidden items-center gap-1.5 text-[13px] text-muted no-underline hover:text-link hover:underline underline-offset-4 sm:inline-flex">by <img src={ORB} width="14" height="14" alt="" class="flex-none" />Dawnlight Labs</a>
        <nav aria-label="Main" class="ml-auto flex items-center text-[14px]">
          {links.map((l) => (
            <a href={l.href} aria-current={nav === l.key ? 'page' : undefined}
              class:list={['px-2 py-2 no-underline hover:underline underline-offset-4 sm:px-3', l.wide && 'hidden sm:inline', nav === l.key ? 'text-ink font-medium underline decoration-[#c47855] decoration-2' : 'text-muted']}>{l.label}</a>
          ))}
          <a href={REPO_URL} class="hidden items-center gap-1 px-3 py-2 text-muted no-underline hover:underline underline-offset-4 sm:inline-flex">GitHub<Icon name="external" class="i-sm" /></a>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <slot />
    </main>

    <footer class="mt-[var(--rhythm)] border-t-[3px] border-ink">
      <div class="bleed grid gap-6 py-10 text-[14px] text-muted sm:grid-cols-[1fr_auto] sm:items-end">
        <div>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-ink"><Mark cap={12} /><a href={DAWNLIGHT_URL} class="inline-flex items-center gap-1.5 text-[13px] text-link underline-offset-4 hover:underline">by <img src={ORB} width="14" height="14" alt="" class="flex-none" />Dawnlight Labs</a></div>
          <p class="mt-3 max-w-sm">An open-source image studio from {ORG}. Local by default: your prompts and images stay on your machine.</p>
        </div>
        <div class="edge flex flex-wrap gap-x-4 gap-y-1">
          <span>v{VERSION}</span>
          <span>{LICENCE}</span>
          <a href={REPO_URL} class="inline-flex items-center gap-1">Source<Icon name="external" class="i-sm" /></a>
          <a href="/vision">Vision</a>
          <a href="/privacy">Privacy</a>
          <a href="/registry.json">registry.json</a>
        </div>
      </div>
    </footer>

    <div class="sr-only" aria-live="polite" id="copy-status"></div>
    <script>
      // Copy buttons: any [data-copy] button copies its value and says so.
      const timers = new WeakMap<HTMLElement, number>();
      document.addEventListener('click', async (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-copy]');
        if (!btn) return;
        const label = btn.querySelector('[data-copy-label]');
        const status = document.getElementById('copy-status');
        try {
          await navigator.clipboard.writeText(btn.dataset.copy ?? '');
          if (label) label.textContent = 'Copied';
          btn.dataset.copied = '';
          if (status) status.textContent = 'Copied to clipboard';
        } catch {
          // No clipboard access: select the command so Ctrl-C works.
          const code = btn.parentElement?.querySelector('code');
          if (code) getSelection()?.selectAllChildren(code);
          if (label) label.textContent = 'Press Ctrl-C';
        }
        clearTimeout(timers.get(btn));
        timers.set(btn, window.setTimeout(() => {
          if (label) label.textContent = 'Copy';
          delete btn.dataset.copied;
        }, 2400));
      });
    </script>
  </body>
</html>
